{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/@core/*"],
      "@styles/*": ["./src/styles/*"],
      "@axios": ["./src/plugins/axios"],
      "@validators": ["./src/@core/utils/validators"],
      "@layouts": ["./src/@layouts/index"],
      "@layouts/*": ["./src/@layouts/*"],
      "@themeConfig": ["./themeConfig.js"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.d.ts", "auto-imports.d.ts"],
  "exclude": ["node_modules", "dist"]
}
